# ─────────────────────────────────────────────────────────────────────────────
# SentinelGate / Zentry — Environment Configuration
# ─────────────────────────────────────────────────────────────────────────────

# ── Application ──────────────────────────────────────────────────────────────
APP_NAME=SentinelGate
APP_ENV=production
DEBUG=false
LOG_LEVEL=INFO

# ── Security (Cryptographic Key) ─────────────────────────────────────────────
# 64 hex characters (32 bytes = 256 bits minimum)
SECRET_KEY=42d017935d58e0ddac25c79a33e47be720abf44bcd34126e7521e8af7204d18a
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# ── Database ─────────────────────────────────────────────────────────────────
POSTGRES_USER=sentinelgate
POSTGRES_PASSWORD=sentinelgate_secure_pass_2026
POSTGRES_DB=sentinelgate
DATABASE_URL=postgresql+asyncpg://sentinelgate:sentinelgate_secure_pass_2026@db:5432/sentinelgate

# ── Redis ────────────────────────────────────────────────────────────────────
REDIS_PASSWORD=sentinelgate_redis_pass_2026
REDIS_URL=redis://:sentinelgate_redis_pass_2026@redis:6379/0

# ── CORS & Frontend ──────────────────────────────────────────────────────────
ALLOWED_ORIGINS=["http://localhost:3000", "http://127.0.0.1:3000", "https://localhost", "http://localhost"]
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_WS_URL=ws://localhost:8000

# ── Gateway / WAF Policies ───────────────────────────────────────────────────
WAF_ENABLED=true
WAF_BLOCK_THREATS=true
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_WINDOW_SECONDS=60
BRUTE_FORCE_WARN_THRESHOLD=5
BRUTE_FORCE_BLOCK_THRESHOLD=10
